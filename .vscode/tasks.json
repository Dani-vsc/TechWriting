{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
        ,
        {
            "label": "build active file (shell)",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["kill test-exes"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        }
        ,
        {
            "label": "kill test-exes",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Process -Name 'test-*' -ErrorAction SilentlyContinue | Stop-Process -Force"
            ],
            "presentation": { "reveal": "never", "panel": "shared" }
        }
        ,
        {
            "label": "build test-1",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-g",
                "${workspaceFolder}\\tests-c\\test-1.c",
                "-o",
                "${workspaceFolder}\\tests-c\\test-1.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["kill test-exes"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
        ,
        {
            "label": "run active wrapper",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\wrappers\\${fileBasenameNoExtension}.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "shared" }
        }
        ,
        {
            "label": "build test-2",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-g",
                "${workspaceFolder}\\tests-c\\test-2.c",
                "-o",
                "${workspaceFolder}\\tests-c\\test-2.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["kill test-exes"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        }
        ,
        {
            "label": "generate wrappers",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\generate-wrappers.ps1"
            ],
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ],
    "version": "2.0.0"
}